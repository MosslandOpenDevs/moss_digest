# ==========================================
# GitHub API 설정 (필수)
# ==========================================
# GitHub Personal Access Token 생성 방법:
# 1. GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# 2. Generate new token 클릭
# 3. 필요한 권한 선택: repo (전체), read:org
# 4. 생성된 토큰을 아래에 입력
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: GitHub App (더 높은 rate limit이 필요한 경우)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ==========================================
# LLM 설정 (AI 요약 기능)
# ==========================================
# LLM Provider 선택: "gemini" 또는 "lmstudio"
# - gemini: Google Gemini API 사용 (클라우드)
# - lmstudio: LM Studio 로컬/원격 서버 사용
LLM_PROVIDER=lmstudio

# ==========================================
# Google Gemini API 설정
# ==========================================
# LLM_PROVIDER=gemini 사용 시에만 필요
# API 키 발급: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ==========================================
# LM Studio API 설정
# ==========================================
# LLM_PROVIDER=lmstudio 사용 시에만 필요

# LMSTUDIO_URL: LM Studio 서버 주소
# - 로컬 서버: http://localhost:8899/v1
# - 원격 서버: http://[Tailscale_IP]:8899/v1 (예: http://100.71.81.27:8899/v1)
# 주의: LM Studio에서 "Start Server" 버튼을 눌러 서버가 실행 중이어야 합니다
LMSTUDIO_URL=http://localhost:8899/v1

# LMSTUDIO_MODEL: 사용할 모델 이름
# - LM Studio에 다운로드된 모델 중 하나를 선택
# - 추천: qwen2.5-32b-instruct, llama-3.1-8b-instruct 등
# - LM Studio 화면에서 "My Models"에서 모델 ID 확인 가능
LMSTUDIO_MODEL=qwen2.5-32b-instruct

# LMSTUDIO_TEMPERATURE: 생성 텍스트의 창의성 조절 (0.0 ~ 1.0)
# - 낮을수록 일관적이고 예측 가능한 결과
# - 높을수록 창의적이고 다양한 결과
# - 요약 작업에는 0.3 권장
LMSTUDIO_TEMPERATURE=0.3

# LMSTUDIO_MAX_TOKENS: 생성할 최대 토큰 수
# - 요약문의 최대 길이 제한
# - 500 = 약 300-400자 정도의 요약문
LMSTUDIO_MAX_TOKENS=500

# LMSTUDIO_MAX_CONTEXT_LENGTH: 입력 텍스트 최대 길이 (문자 수)
# - 너무 긴 문서는 앞부분만 잘라서 사용
# - 8000 = 약 5000-7000자 정도의 문서
LMSTUDIO_MAX_CONTEXT_LENGTH=8000

# LMSTUDIO_TIMEOUT: API 요청 타임아웃 (밀리초)
# - 로컬 서버 + 작은 모델: 60000 (1분)
# - 로컬 서버 + 큰 모델: 180000 (3분)
# - 원격 서버 + 큰 모델: 600000 (10분) 이상 권장
# 주의: 타임아웃이 너무 짧으면 요약 생성 중 연결이 끊어질 수 있습니다
LMSTUDIO_TIMEOUT=300000

# ==========================================
# 알림 설정 (선택사항)
# ==========================================
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
