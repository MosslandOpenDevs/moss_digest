# GitHub API (필수)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: 더 높은 rate limit을 위한 GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Google Gemini API (Optional: 공시 자료 AI 요약 기능)
# https://makersuite.google.com/app/apikey 에서 생성
GEMINI_API_KEY=

# Optional: 알림 설정
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
