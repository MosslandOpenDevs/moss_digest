<%
  // Helper function to safely format dates
  function formatDate(dateValue, format = 'short') {
    const date = dateValue instanceof Date ? dateValue : new Date(dateValue);
    if (format === 'short') {
      return date.toLocaleDateString('ko-KR');
    } else if (format === 'long') {
      return date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
    } else if (format === 'datetime') {
      return date.toLocaleString('ko-KR');
    }
    return date.toLocaleDateString('ko-KR');
  }
%>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MossDigest 상세 보고서 - <%= reportTitle %></title>
  <style>
    :root {
      --primary-color: #008080;
      --primary-dark: #006666;
      --primary-light: #20b2aa;
      --secondary-color: #40e0d0;
      --bg-color: #ffffff;
      --text-color: #333333;
      --text-secondary: #666666;
      --border-color: #e0e0e0;
      --code-bg: #f5f5f5;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      line-height: 1.6;
      padding: 20px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    header {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
      color: white;
      padding: 30px;
      margin-bottom: 30px;
      border-radius: 8px;
    }

    header h1 {
      font-size: 2em;
      margin-bottom: 10px;
    }

    .toc {
      background: var(--code-bg);
      padding: 20px;
      margin-bottom: 30px;
      border-radius: 6px;
      border-left: 4px solid var(--primary-color);
    }

    .toc h2 {
      font-size: 1.2em;
      margin-bottom: 15px;
      color: var(--primary-dark);
    }

    .toc ul {
      list-style: none;
      padding-left: 10px;
    }

    .toc li {
      margin: 8px 0;
    }

    .toc a {
      color: var(--primary-color);
      text-decoration: none;
    }

    .toc a:hover {
      text-decoration: underline;
    }

    .section {
      margin-bottom: 40px;
      page-break-inside: avoid;
    }

    .section h2 {
      color: var(--primary-dark);
      font-size: 1.8em;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 3px solid var(--primary-color);
    }

    .section h3 {
      color: var(--primary-color);
      font-size: 1.3em;
      margin: 25px 0 15px;
    }

    .blog-detail {
      margin-bottom: 30px;
      padding: 20px;
      background: var(--code-bg);
      border-radius: 6px;
      page-break-inside: avoid;
    }

    .blog-detail h3 {
      color: var(--primary-dark);
      margin-top: 0;
    }

    .blog-detail .meta {
      font-size: 0.9em;
      color: var(--text-secondary);
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border-color);
    }

    .blog-detail .content {
      line-height: 1.8;
    }

    .commit-list {
      list-style: none;
    }

    .commit-item {
      margin-bottom: 20px;
      padding: 15px;
      background: var(--code-bg);
      border-radius: 6px;
      border-left: 3px solid var(--secondary-color);
      page-break-inside: avoid;
    }

    .commit-item .sha {
      font-family: 'Courier New', monospace;
      font-size: 0.85em;
      color: var(--text-secondary);
    }

    .commit-item .message {
      font-weight: 500;
      margin: 8px 0;
      color: var(--primary-dark);
    }

    .commit-item .author {
      font-size: 0.9em;
      color: var(--text-secondary);
    }

    .commit-item .stats {
      margin-top: 8px;
      font-size: 0.9em;
      color: var(--text-secondary);
    }

    .commit-item .stats .additions {
      color: #4caf50;
    }

    .commit-item .stats .deletions {
      color: #f44336;
    }

    .file-changes {
      margin-top: 10px;
      padding: 10px;
      background: white;
      border-radius: 4px;
    }

    .file-changes h4 {
      font-size: 0.9em;
      color: var(--primary-color);
      margin-bottom: 8px;
    }

    .file-changes ul {
      list-style: none;
      font-size: 0.85em;
    }

    .file-changes li {
      padding: 3px 0;
      font-family: 'Courier New', monospace;
    }

    .file-status {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 0.8em;
      margin-right: 5px;
    }

    .file-status.added {
      background-color: #4caf50;
      color: white;
    }

    .file-status.modified {
      background-color: #2196f3;
      color: white;
    }

    .file-status.removed {
      background-color: #f44336;
      color: white;
    }

    .statistics-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }

    .statistics-table th,
    .statistics-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }

    .statistics-table th {
      background-color: var(--primary-color);
      color: white;
      font-weight: 500;
    }

    .statistics-table tr:hover {
      background-color: var(--code-bg);
    }

    .release-item {
      margin-bottom: 20px;
      padding: 15px;
      background: var(--code-bg);
      border-radius: 6px;
      border-left: 3px solid var(--primary-light);
    }

    .release-item h4 {
      color: var(--primary-dark);
      margin-bottom: 8px;
    }

    .release-item .meta {
      font-size: 0.9em;
      color: var(--text-secondary);
      margin-bottom: 10px;
    }

    .release-item .body {
      white-space: pre-wrap;
      line-height: 1.6;
    }

    .badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 0.85em;
      font-weight: 500;
      margin-left: 5px;
    }

    .badge-prerelease {
      background-color: #ff9800;
      color: white;
    }

    footer {
      margin-top: 50px;
      padding-top: 20px;
      border-top: 2px solid var(--border-color);
      text-align: center;
      color: var(--text-secondary);
      font-size: 0.9em;
    }

    @media print {
      body {
        padding: 0;
      }

      .section {
        page-break-after: auto;
      }

      header {
        page-break-after: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>MossDigest 상세 보고서</h1>
      <div class="subtitle"><%= reportTitle %></div>
      <div class="period"><%= period %></div>
    </header>

    <!-- 목차 -->
    <div class="toc">
      <h2>📑 목차</h2>
      <ul>
        <% if (blogPosts && blogPosts.length > 0) { %>
        <li><a href="#section-blog">1. 블로그 발행 상세</a></li>
        <% } %>
        <% if (commits && commits.length > 0) { %>
        <li><a href="#section-commits">2. GitHub 커밋 로그</a></li>
        <% } %>
        <% if (fileChanges && fileChanges.length > 0) { %>
        <li><a href="#section-files">3. 파일 변경 내역</a></li>
        <% } %>
        <% if (releases && releases.length > 0) { %>
        <li><a href="#section-releases">4. 릴리즈 목록</a></li>
        <% } %>
        <li><a href="#section-statistics">5. 통계</a></li>
      </ul>
    </div>

    <!-- 블로그 발행 상세 -->
    <% if (blogPosts && blogPosts.length > 0) { %>
    <div class="section" id="section-blog">
      <h2>1. 블로그 발행 상세</h2>
      <% blogPosts.forEach((post, index) => { %>
      <div class="blog-detail">
        <h3><%= index + 1 %>. <%= post.title %></h3>
        <div class="meta">
          <strong>발행일:</strong> <%= formatDate(post.pubDate, 'long') %><br>
          <strong>저자:</strong> <%= post.author %><br>
          <strong>링크:</strong> <a href="<%= post.link %>" target="_blank"><%= post.link %></a>
          <% if (post.categories && post.categories.length > 0) { %>
          <br><strong>카테고리:</strong> <%= post.categories.join(', ') %>
          <% } %>
        </div>
        <div class="content">
          <%= post.summary %>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>

    <!-- GitHub 커밋 로그 -->
    <% if (commits && commits.length > 0) { %>
    <div class="section" id="section-commits">
      <h2>2. GitHub 커밋 로그</h2>
      <ul class="commit-list">
        <% commits.forEach(commit => { %>
        <li class="commit-item">
          <div class="sha">
            <a href="<%= commit.url %>" target="_blank"><%= commit.sha.substring(0, 7) %></a>
          </div>
          <div class="message"><%= commit.message %></div>
          <div class="author">
            <%= commit.author %> (<%= commit.email %>)
            · <%= formatDate(commit.date, 'datetime') %>
          </div>
          <% if (commit.additions || commit.deletions) { %>
          <div class="stats">
            <span class="additions">+<%= commit.additions %></span>
            <span class="deletions">-<%= commit.deletions %></span>
            (<%= commit.total %> changes)
          </div>
          <% } %>
        </li>
        <% }); %>
      </ul>
    </div>
    <% } %>

    <!-- 파일 변경 내역 -->
    <% if (fileChanges && fileChanges.length > 0) { %>
    <div class="section" id="section-files">
      <h2>3. 파일 변경 내역</h2>
      <% fileChanges.forEach(change => { %>
      <% if (change.files && change.files.length > 0) { %>
      <div class="file-changes">
        <h4>
          Commit: <%= change.commitSha.substring(0, 7) %>
          · <%= change.commitMessage %>
        </h4>
        <ul>
          <% change.files.forEach(file => { %>
          <li>
            <span class="file-status <%= file.status %>"><%= file.status %></span>
            <%= file.filename %>
            <% if (file.additions || file.deletions) { %>
            (<span class="additions">+<%= file.additions %></span>
            <span class="deletions">-<%= file.deletions %></span>)
            <% } %>
          </li>
          <% }); %>
        </ul>
      </div>
      <% } %>
      <% }); %>
    </div>
    <% } %>

    <!-- 릴리즈 목록 -->
    <% if (releases && releases.length > 0) { %>
    <div class="section" id="section-releases">
      <h2>4. 릴리즈 목록</h2>
      <% releases.forEach(release => { %>
      <div class="release-item">
        <h4>
          <%= release.name %>
          <% if (release.prerelease) { %>
          <span class="badge badge-prerelease">Pre-release</span>
          <% } %>
        </h4>
        <div class="meta">
          <strong>Tag:</strong> <%= release.tagName %><br>
          <strong>발행일:</strong> <%= formatDate(release.publishedAt) %><br>
          <% if (release.author) { %>
          <strong>작성자:</strong> <%= release.author %><br>
          <% } %>
          <strong>링크:</strong> <a href="<%= release.url %>" target="_blank"><%= release.url %></a>
        </div>
        <% if (release.body) { %>
        <div class="body"><%= release.body %></div>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } %>

    <!-- 통계 -->
    <div class="section" id="section-statistics">
      <h2>5. 통계</h2>

      <h3>전체 요약</h3>
      <table class="statistics-table">
        <thead>
          <tr>
            <th>항목</th>
            <th>개수</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>블로그 발행</td>
            <td><%= statistics.totalBlogPosts || 0 %> 건</td>
          </tr>
          <tr>
            <td>총 커밋</td>
            <td><%= statistics.totalCommits || 0 %> commits</td>
          </tr>
          <tr>
            <td>변경된 파일</td>
            <td><%= statistics.totalFilesChanged || 0 %> files</td>
          </tr>
          <tr>
            <td>신규 저장소</td>
            <td><%= statistics.newRepositories || 0 %> repos</td>
          </tr>
          <tr>
            <td>릴리즈</td>
            <td><%= statistics.totalReleases || 0 %> releases</td>
          </tr>
          <tr>
            <td>외부 링크</td>
            <td><%= statistics.externalLinks || 0 %> links</td>
          </tr>
        </tbody>
      </table>

      <% if (statistics.topContributors && statistics.topContributors.length > 0) { %>
      <h3>주요 기여자</h3>
      <table class="statistics-table">
        <thead>
          <tr>
            <th>이름</th>
            <th>커밋 수</th>
          </tr>
        </thead>
        <tbody>
          <% statistics.topContributors.forEach(contributor => { %>
          <tr>
            <td><%= contributor.name %></td>
            <td><%= contributor.commits %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>

    <footer>
      <p>Generated by MossDigest on <%= new Date().toLocaleString('ko-KR') %></p>
      <p>Report Period: <%= period %></p>
    </footer>
  </div>
</body>
</html>
