<%
  // Helper function to safely format dates
  function formatDate(dateValue, format = 'short') {
    const date = dateValue instanceof Date ? dateValue : new Date(dateValue);
    if (format === 'short') {
      return date.toLocaleDateString('ko-KR');
    } else {
      return date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
    }
  }
%>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mossland — <%= reportTitle %></title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Space+Mono:wght@400;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    /* =================
       CSS Variables (Dark Mode Design System)
       ================= */
    :root {
      /* Background */
      --bg: #0a0a0f;
      --bg2: #12121a;
      --bg3: #1a1a26;
      --surface: #1e1e2e;
      --border: #2a2a3a;

      /* Text */
      --text: #e8e6e3;
      --text2: #9a98a0;
      --text3: #6a6870;

      /* Accent Colors */
      --accent: #00d4aa;
      --accent2: #00b894;
      --accent-glow: rgba(0, 212, 170, 0.15);

      /* Status Colors */
      --coral: #ff6b6b;
      --amber: #ffd93d;
      --blue: #6c5ce7;
      --purple: #a29bfe;

      /* Typography */
      --font-display: "Instrument Serif", Georgia, serif;
      --font-body: "DM Sans", system-ui, sans-serif;
      --font-mono: "Space Mono", monospace;
    }

    /* =================
       Base Styles
       ================= */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 400;
      line-height: 1.2;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    a:hover {
      color: var(--accent2);
    }

    /* =================
       Navigation
       ================= */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      background: rgba(10, 10, 15, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      z-index: 1000;
      transition: transform 0.3s ease;
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      color: var(--text);
    }

    .nav-logo span {
      color: var(--text3);
    }

    .nav-center {
      display: flex;
      gap: 2rem;
    }

    .nav-center a {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text2);
      position: relative;
      padding: 0.5rem 0;
      transition: color 0.3s ease;
    }

    .nav-center a:hover,
    .nav-center a.active {
      color: var(--accent);
    }

    .nav-center a.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--accent);
    }

    /* =================
       Hero Section
       ================= */
    .hero {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8rem 2rem 4rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
      pointer-events: none;
      opacity: 0.5;
    }

    .hero h1 {
      font-size: 3.2rem;
      margin-bottom: 1rem;
      position: relative;
      z-index: 1;
    }

    .hero h1 em {
      color: var(--accent);
      font-style: italic;
    }

    .hero .subtitle {
      font-size: 1.1rem;
      color: var(--text2);
      margin-bottom: 0.5rem;
    }

    .hero .period {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text3);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 3rem;
    }

    /* =================
       Stats Banner
       ================= */
    .stats-banner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
      position: relative;
      z-index: 1;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 212, 170, 0.1);
    }

    .stat-num {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: var(--accent);
      margin-bottom: 0.5rem;
      counter-reset: stat-counter;
    }

    .stat-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--text2);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .stat-sub {
      font-size: 0.7rem;
      color: var(--text3);
      margin-top: 0.25rem;
    }

    /* =================
       Section Base
       ================= */
    .section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2rem;
      position: relative;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--text3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }

    .section-label::before {
      content: attr(data-num);
      color: var(--accent);
      margin-right: 0.5rem;
    }

    .section h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .section h2 em {
      color: var(--accent);
      font-style: italic;
    }

    .section-desc {
      color: var(--text2);
      max-width: 800px;
      margin-bottom: 3rem;
      line-height: 1.8;
    }

    /* =================
       Chart Container
       ================= */
    .chart-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 3rem;
    }

    .chart-container canvas {
      max-height: 400px !important;
    }

    /* =================
       Content Lists
       ================= */
    .content-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .content-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .content-item:hover {
      transform: translateX(4px);
      border-color: var(--accent);
    }

    .content-item h3 {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .content-item h3 a {
      color: var(--text);
      transition: color 0.3s ease;
    }

    .content-item h3 a:hover {
      color: var(--accent);
    }

    .content-meta {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--text3);
      margin-bottom: 0.75rem;
      letter-spacing: 0.05em;
    }

    .content-summary {
      color: var(--text2);
      line-height: 1.7;
      font-size: 0.88rem;
    }

    .ai-summary {
      margin-top: 1rem;
      padding: 1rem;
      background: rgba(0, 212, 170, 0.05);
      border-left: 3px solid var(--accent);
      border-radius: 4px;
    }

    .ai-summary strong {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--accent);
      display: block;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .ai-summary p {
      color: var(--text);
      margin: 0;
      line-height: 1.7;
    }

    /* =================
       Repository Grid
       ================= */
    .repo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .repo-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .repo-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 212, 170, 0.1);
    }

    .repo-card h4 {
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
      color: var(--text);
    }

    .repo-stats {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .repo-stat {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text3);
      letter-spacing: 0.05em;
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-left: 0.5rem;
    }

    .badge-new {
      background: var(--accent);
      color: var(--bg);
    }

    .badge-lang {
      background: var(--bg3);
      color: var(--text2);
    }

    /* =================
       Footer
       ================= */
    .footer {
      text-align: center;
      padding: 4rem 2rem;
      border-top: 1px solid var(--border);
      color: var(--text3);
    }

    .footer p {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }

    .footer-links {
      margin-top: 1rem;
      display: flex;
      gap: 2rem;
      justify-content: center;
    }

    .footer-links a {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    /* =================
       Animations
       ================= */
    .fade-up {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.65s ease-out, transform 0.65s ease-out;
    }

    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* =================
       Responsive
       ================= */
    @media (max-width: 1024px) {
      .stats-banner {
        grid-template-columns: repeat(3, 1fr);
      }

      .nav-center {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2.2rem;
      }

      .section {
        padding: 4rem 1.25rem;
      }

      .stats-banner {
        grid-template-columns: repeat(2, 1fr);
      }

      .repo-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .stats-banner {
        grid-template-columns: 1fr;
      }

      .section h2 {
        font-size: 1.6rem;
      }
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <nav class="nav" id="nav">
    <div class="nav-logo">MOSSLAND <span>/ <%= period %></span></div>
    <div class="nav-center">
      <a href="#overview" class="active">개요</a>
      <a href="#blog">블로그</a>
      <a href="#github">GitHub</a>
      <a href="#external">공시</a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero" id="overview">
    <h1>Mossland — <em><%= reportTitle %></em></h1>
    <div class="subtitle">개발 활동 및 커뮤니티 보고서</div>
    <div class="period"><%= period %></div>

    <!-- Stats Banner -->
    <div class="stats-banner fade-up">
      <div class="stat-card">
        <div class="stat-num"><%= metrics.totalCommits %></div>
        <div class="stat-label">Commits</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.totalPullRequests %></div>
        <div class="stat-label">Pull Requests</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.totalIssues %></div>
        <div class="stat-label">Issues</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.prMergeRate %>%</div>
        <div class="stat-label">PR Merge Rate</div>
        <div class="stat-sub"><%= metrics.mergedPullRequests %>/<%= metrics.totalPullRequests %> merged</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.issueClosureRate %>%</div>
        <div class="stat-label">Issue Closure</div>
        <div class="stat-sub"><%= metrics.closedIssues %>/<%= metrics.totalIssues %> closed</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.totalContributors %></div>
        <div class="stat-label">Contributors</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.totalBlogPosts %></div>
        <div class="stat-label">Blog Posts</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.newRepositories %></div>
        <div class="stat-label">New Repos</div>
      </div>

      <div class="stat-card">
        <div class="stat-num"><%= metrics.totalReleases %></div>
        <div class="stat-label">Releases</div>
      </div>
    </div>
  </section>

  <!-- Monthly Commit Trend -->
  <section class="section">
    <div class="section-label" data-num="01">통계</div>
    <h2>월별 <em>커밋 트렌드</em></h2>
    <p class="section-desc">연간 개발 활동의 흐름을 한눈에 확인할 수 있습니다.</p>

    <div class="chart-container">
      <canvas id="monthlyCommitChart"></canvas>
    </div>
  </section>

  <!-- Blog Posts -->
  <% if (blogPosts && blogPosts.length > 0) { %>
  <section class="section" id="blog">
    <div class="section-label" data-num="02">콘텐츠</div>
    <h2>블로그 <em>발행 목록</em></h2>
    <p class="section-desc">기술 아티클, 업데이트 소식, 커뮤니티 활동을 공유합니다.</p>

    <ul class="content-list">
      <% blogPosts.forEach(post => { %>
      <li class="content-item">
        <h3><a href="<%= post.link %>" target="_blank"><%= post.title %></a></h3>
        <div class="content-meta">
          <%= formatDate(post.pubDate, 'long') %> · <%= post.author %>
        </div>
        <% if (post.aiSummary) { %>
        <div class="ai-summary">
          <strong>🤖 AI 요약</strong>
          <p><%= post.aiSummary %></p>
        </div>
        <% } else { %>
        <div class="content-summary"><%= post.summary %></div>
        <% } %>
      </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

  <!-- GitHub Activity -->
  <% if (repositories && repositories.length > 0) { %>
  <section class="section" id="github">
    <div class="section-label" data-num="03">개발</div>
    <h2>GitHub <em>개발 활동</em></h2>
    <p class="section-desc">오픈소스 프로젝트에 기여하고 새로운 기능을 개발합니다.</p>

    <div class="repo-grid">
      <% repositories.forEach(repo => { %>
      <div class="repo-card">
        <h4>
          <%= repo.name %>
          <% if (repo.isNew) { %>
          <span class="badge badge-new">NEW</span>
          <% } %>
          <% if (repo.language) { %>
          <span class="badge badge-lang"><%= repo.language %></span>
          <% } %>
        </h4>
        <% if (repo.description) { %>
        <p><%= repo.description %></p>
        <% } %>
        <div class="repo-stats">
          <div class="repo-stat">⚡ <%= repo.commits %> commits</div>
          <% if (repo.releases > 0) { %>
          <div class="repo-stat">🚀 <%= repo.releases %> releases</div>
          <% } %>
          <% if (repo.stars !== undefined) { %>
          <div class="repo-stat">⭐ <%= repo.stars %> stars</div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- New Repositories -->
  <% if (newRepositories && newRepositories.length > 0) { %>
  <section class="section">
    <div class="section-label" data-num="04">신규 프로젝트</div>
    <h2>신규 <em>저장소</em></h2>
    <p class="section-desc">새롭게 시작된 프로젝트들입니다.</p>

    <div class="repo-grid">
      <% newRepositories.forEach(repo => { %>
      <div class="repo-card">
        <h4>
          <a href="<%= repo.url %>" target="_blank"><%= repo.fullName %></a>
          <span class="badge badge-new">NEW</span>
          <% if (repo.language) { %>
          <span class="badge badge-lang"><%= repo.language %></span>
          <% } %>
        </h4>
        <% if (repo.description) { %>
        <p><%= repo.description %></p>
        <% } %>
        <div class="content-meta">
          생성일: <%= formatDate(repo.createdAt) %>
        </div>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- External Links -->
  <% if (externalLinks && externalLinks.length > 0) { %>
  <section class="section" id="external">
    <div class="section-label" data-num="05">공시 자료</div>
    <h2>공시 및 <em>외부 문서</em></h2>
    <p class="section-desc">공식 발표 자료와 외부 문서들입니다.</p>

    <ul class="content-list">
      <% externalLinks.forEach(link => { %>
      <li class="content-item">
        <h3><a href="<%= link.url %>" target="_blank"><%= link.title %></a></h3>
        <div class="content-meta">
          <%= formatDate(link.date, 'long') %>
        </div>
        <% if (link.summary) { %>
        <div class="ai-summary">
          <strong>🤖 AI 요약</strong>
          <p><%= link.summary %></p>
        </div>
        <% } %>
      </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

  <!-- Footer -->
  <footer class="footer">
    <p>Generated by MossDigest on <%= new Date().toLocaleString('ko-KR') %></p>
    <div class="footer-links">
      <a href="https://github.com/mossland" target="_blank">GitHub</a>
      <a href="https://medium.com/mossland-blog" target="_blank">Medium Blog</a>
    </div>
  </footer>

  <!-- Scripts -->
  <script>
    // Monthly Commit Trend Chart (Dark Mode)
    const ctx = document.getElementById('monthlyCommitChart');
    const monthlyData = <%- JSON.stringify(monthlyCommitTrend) %>;

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
        datasets: [{
          label: 'Commits',
          data: monthlyData,
          borderColor: '#00d4aa',
          backgroundColor: 'rgba(0, 212, 170, 0.1)',
          fill: true,
          tension: 0.4,
          borderWidth: 3,
          pointBackgroundColor: '#00d4aa',
          pointBorderColor: '#1e1e2e',
          pointBorderWidth: 2,
          pointRadius: 5,
          pointHoverRadius: 7,
          pointHoverBackgroundColor: '#00d4aa',
          pointHoverBorderColor: '#fff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.9)',
            titleColor: '#e8e6e3',
            bodyColor: '#9a98a0',
            borderColor: '#2a2a3a',
            borderWidth: 1,
            padding: 12,
            titleFont: {
              family: "'Instrument Serif', Georgia, serif",
              size: 14,
              weight: 'normal'
            },
            bodyFont: {
              family: "'DM Sans', system-ui, sans-serif",
              size: 13
            },
            callbacks: {
              label: function(context) {
                return 'Commits: ' + context.parsed.y;
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: 'rgba(42, 42, 58, 0.5)',
              drawBorder: false
            },
            ticks: {
              color: '#6a6870',
              font: {
                family: "'Space Mono', monospace",
                size: 11
              },
              stepSize: Math.max(1, Math.ceil(Math.max(...monthlyData) / 5))
            }
          },
          x: {
            grid: {
              display: false
            },
            ticks: {
              color: '#6a6870',
              font: {
                family: "'Space Mono', monospace",
                size: 11
              }
            }
          }
        },
        interaction: {
          intersect: false,
          mode: 'index'
        }
      }
    });

    // Fade-up animation on scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

    // Active nav link tracking
    function updateActiveNav() {
      const sections = document.querySelectorAll('.section');
      let current = 'overview';

      sections.forEach(section => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.clientHeight;
        if (window.scrollY >= sectionTop - 200) {
          current = section.id || current;
        }
      });

      document.querySelectorAll('.nav-center a').forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + current) {
          link.classList.add('active');
        }
      });
    }

    window.addEventListener('scroll', updateActiveNav);
  </script>

</body>
</html>
